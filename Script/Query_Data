/* --- CLAUSES ---- */

/*  SELECT */ 
-- Retrieve All Customer Data
select * from customers;
-- Retrieve All Order Data
select * from orders;
-- Retrieve each customer's name, country, score
select first_name, country, score from customers;

/* WHERE  */
-- Q : Filter our Data based on condition
select * from customers where score>500;
-- Q : Retrieve Customers with a score != 0
select * from customers where score!=0;
-- Q : Retrieve customers from Germany
select * from customers where country='Germany';

/* ORDER BY */
-- Q : Retrieve all customers and sort the results by the highest score first
select * from customers order by score desc;
-- Q : Retrieve all customers and sort the results by the lowest score first
select * from customers order by score;
-- Q : Retrieve all customers and sort the id by higher to lower
select * from customers order by id desc;
-- Q : Retrieve all customers and sort the results by the country and then by highest score
select * from customers order by country asc, score desc;

use myDatabase;

/* GROUP BY   */
-- Q : find the total score for each country
select country, sum(score) as total_score from customers group by country;
-- Problem  :: This will give error beacause :: group by RULE :: All column in the select must be aggregated or included in the group by, but you select first_name which is not aggregated !!
select country, first_name, sum(score) as total_score from customers group by country;
-- Correction :: select first_name after aggregating in group by
select country, first_name, sum(score) as total_score from customers group by country, first_name;
-- Q : find the total score and total number of customers for each country
select country, count(id) as total_customers, sum(score) as total_score from customers group by country;


/*  HAVING  */
-- Using Having
select country, sum(score) as total_score from customers group by country having total_score > 800;
-- use Having and Where together 
select country, sum(score) as total_score from customers where score>400 group by country having total_score > 800;
-- Q :: find the average score for each country considering only customers with a score not equal to 0
-- -- And return only those countries with an average score greater than 430
select country, avg(score) as average_score from customers where score != 0 group by country having average_score>430;
 
/* DISTINCT */
select distinct country from customers;

/* LIMIT */
select * from customers limit 3;
-- Q :: Retrieve the top 3 customers with the Highest scores
select * from customers order by score desc limit 3;
-- Q :: Retrieve the lowest 2 customers based on the scores
select * from customers order by score limit 2;
-- Q :: GEt the two most recent orders
select * from orders order by order_date desc limit 2;

/* MULTIPLE QUERIES */
select * from customers;
select * from orders;

/* Static(fixed) values */
/* FIXED FOR ALL ROWS IN TABLE */
select 123 as score;
select 123 as score,'India' as country;
/* using static data and data of database together */
select id, first_name, 'India' as country from customers;
select id, first_name, 'New_customer' as customer_type from customers;

